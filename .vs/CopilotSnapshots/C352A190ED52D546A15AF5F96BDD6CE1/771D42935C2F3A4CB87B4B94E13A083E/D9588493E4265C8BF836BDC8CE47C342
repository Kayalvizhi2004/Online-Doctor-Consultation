version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: consultationdb
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  rabbitmq:
    image: rabbitmq:3.11-management
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest
    ports:
      - "5672:5672"
      - "15672:15672"

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"

  consultationapi:
    image: mcr.microsoft.com/dotnet/sdk:8.0
    working_dir: /src
    volumes:
      - ..:/src:cached
    command: dotnet run --project backend/ConsultationApi/ConsultationApi.csproj --urls http://0.0.0.0:5000
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=consultationdb;Username=postgres;Password=postgres
      - Redis__Configuration=redis:6379
      - RabbitMq__HostName=rabbitmq
      - RabbitMq__Port=5672
      - RabbitMq__UserName=guest
      - RabbitMq__Password=guest
      - Jwt__SecretKey=ThisIsMySuperSecretJwtKey123456789
    ports:
      - "5000:5000"
    depends_on:
      - postgres
      - rabbitmq
      - redis

  consultationworker:
    image: mcr.microsoft.com/dotnet/sdk:8.0
    working_dir: /src
    volumes:
      - ..:/src:cached
    command: dotnet run --project backend/ConsultationWorker/ConsultationWorker.csproj
    environment:
      - ASPNETCORE_ENVIRONMENT=Development
      - ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=consultationdb;Username=postgres;Password=postgres
      - Redis__Configuration=redis:6379
      - RabbitMq__HostName=rabbitmq
      - RabbitMq__Port=5672
      - RabbitMq__UserName=guest
      - RabbitMq__Password=guest
      - Jwt__SecretKey=ThisIsMySuperSecretJwtKey123456789
    depends_on:
      - postgres
      - rabbitmq
      - redis

volumes:
  pgdata:
